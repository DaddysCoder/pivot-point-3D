# Godot 4.4.1 project — Pivot Point 3D
# Phase 1: game feel (controller, camera, interaction, test environment)

config_version=5

[application]

config/name="Pivot Point 3D"
config/description="Plans change. Find your next move. Third-person strategy/adventure."
config/version="0.3.0-art"
run/main_scene="res://scenes/main/boot.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/ui/pivot-point-icon.png"

[autoload]

GameSettings="*res://scripts/systems/game_settings.gd"
GameState="*res://scripts/systems/game_state.gd"
SceneRouter="*res://scripts/systems/scene_router.gd"
CursorManager="*res://scripts/systems/cursor_manager.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
FacilitatorProfiles="*res://scripts/systems/facilitator_profiles.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

